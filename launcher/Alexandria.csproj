<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Alexandria</AssemblyName>
    <RootNamespace>Alexandria</RootNamespace>
    <Product>Alexandria</Product>
    <Company>Cat-Attack</Company>
    <Authors>Cat-Attack</Authors>
    <Copyright>Copyright © Cat-Attack</Copyright>
    <Description>Alexandria (Realm Library suite). Creado por Cat-Attack.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="bundle.zip" Condition="Exists('bundle.zip')" />
  </ItemGroup>
</Project>
